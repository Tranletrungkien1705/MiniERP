{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "Default": "Data Source=minierp.db"
  },
  "IdentityProvider": {
    "AuthorityUrl": "https://localhost:44389",
    "ClientId": "CHANGE_ME",
    "ClientSecret": "CHANGE_ME",
    "Scope": "api"
  },
  "Jwt": {
    "Issuer": "MiniERP",
    "Audience": "MiniERP.Clients",
    "SigningKey": "dev-only-signing-key-change-me-in-appsettings-Development-or-secret-store-32chars",
    "ExpiryMinutes": 60
  }
}
